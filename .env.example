# App
NODE_ENV=development
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-output-from-openssl-rand-base64-32
SITE_DOMAIN=site.localhost
DOCS_HOST=docs.localhost
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/yeeet
ADMIN_EMAILS=admin@example.com
INITIAL_INVITATION_CODE=local-development-invitation
# Project-scoped token used only to provision custom domains and managed TLS.
# Optional locally. Never commit a real token.
RAILWAY_TOKEN=

# GitHub OAuth (optional locally, required for the GitHub button in production)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
VITE_GITHUB_AUTH_ENABLED=false

# Railway Bucket. The shorter Railway-provided names (ENDPOINT, BUCKET,
# ACCESS_KEY_ID, SECRET_ACCESS_KEY, REGION) are accepted as fallbacks.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_FORCE_PATH_STYLE=false
# Optional comma-separated override used only by `npm run bucket:cors`.
S3_CORS_ORIGINS=http://localhost:3000

# Limits
MAX_DEPLOY_BYTES=524288000
DB_POOL_SIZE=10
