{
  "name": "yeeet",
  "private": true,
  "description": "An open-source static-site deployment platform for humans, CLIs, CI, and agents.",
  "license": "MIT",
  "homepage": "https://github.com/nearbycoder/yeeet.dev#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nearbycoder/yeeet.dev.git"
  },
  "bugs": {
    "url": "https://github.com/nearbycoder/yeeet.dev/issues"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "packageManager": "npm@11.18.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:prod": "node scripts/migrate.mjs",
    "admin:bootstrap": "node scripts/bootstrap-admin.mjs",
    "bucket:cors": "node scripts/configure-bucket-cors.mjs",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "start": "node .output/server/index.mjs",
    "cli": "node packages/cli/bin/yeeet.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "test:browser": "node tests/browser/action-feedback.mjs",
    "test:integration": "node --import tsx --test tests/integration/*.integration.ts",
    "audit:dependencies": "npm audit --audit-level=moderate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@aws-sdk/s3-request-presigner": "^3.1136.0",
    "@better-auth/api-key": "^1.7.5",
    "@expo-google-fonts/open-sans": "^0.4.2",
    "@resvg/resvg-js": "^2.6.2",
    "@tanstack/react-devtools": "^0.10.12",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-query-devtools": "^5.103.1",
    "@tanstack/react-router": "^1.170.38",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.168.56",
    "better-auth": "^1.7.5",
    "drizzle-orm": "^0.45.2",
    "mime-types": "^3.0.2",
    "nitro": "3.0.260903-beta",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tldts": "^7.4.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/eslint-config": "^0.4.0",
    "@tanstack/router-cli": "^1.167.38",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.6.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^18.0.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.11.0",
    "prettier": "^3.9.8",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.28.2"
    }
  }
}
